---
import DesentaBox from './DesentaBox.astro';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import { tools } from '../data/tools';
import { T } from '../i18n';
const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const P = ru ? '/ru' : '';
const all = await getCollection('articles', (a) => !a.data.draft);
const byLang = all.filter((a) => a.data.lang === lang);
// RU has few translated articles: fall back to English ones so the page is never empty
const pool = (byLang.length >= 5 ? byLang : all.filter((a) => a.data.lang === 'en'));
const href = (a: any) => `${a.data.lang === 'ru' ? '/ru' : ''}/${a.data.section}/${a.id.replace(/^ru\//, '')}/`;
const recent = [...pool].filter((a) => a.data.section !== 'reviews').sort((x, y) => (y.data.published ?? y.data.updated).valueOf() - (x.data.published ?? x.data.updated).valueOf());
const withImg = recent.filter((a) => a.data.image);
const featured = withImg[0] ?? recent[0];
const rest = recent.filter((a) => a !== featured).slice(0, 6);
const news = all.filter((a) => a.data.section === 'news' && a.data.lang === 'en').sort((x, y) => (y.data.published ?? y.data.updated).valueOf() - (x.data.published ?? x.data.updated).valueOf()).slice(0, 4);
const L = ru
  ? { lede: 'Независимые обзоры и сравнения программ и оборудования для дизайнеров интерьера. Цены и функции берём с официальных сайтов.', browse: 'Каталог', compare: 'Сравнить программы', latest: 'Свежее', news: 'Новости', all: 'Все', catalog: 'В каталоге', free: 'Есть бесплатный вариант', sections: [
      { href: '/software/', t: 'Каталог и обзоры', d: 'Все программы: фильтры, цены, сравнение.' }, { href: '/best/', t: 'Лучшее', d: 'Подборки по задачам с нашим выбором.' }, { href: '/gear/', t: 'Оборудование', d: 'Лазерные рулетки, планшеты, мониторы.' }, { href: '/guides/', t: 'Гайды', d: 'Как выбрать и с чего начать.' }, { href: '/news/', t: 'Новости', d: 'Новинки и обновления.' }] }
  : { lede: 'Independent reviews and side-by-side comparisons of the software and gear interior designers use. Prices and features come from the vendors’ own sites.', browse: 'Browse the catalog', compare: 'Compare tools', latest: 'Latest', news: 'News', all: 'All', catalog: 'In the catalog', free: 'Has a free option', sections: [
      { href: '/software/', t: 'Software & reviews', d: 'Every tool: filters, prices, comparison.' }, { href: '/best/', t: 'Best of', d: 'Shortlists by job, with our pick.' }, { href: '/gear/', t: 'Gear', d: 'Laser measures, tablets, monitors.' }, { href: '/guides/', t: 'Guides', d: 'How to choose and where to start.' }, { href: '/news/', t: 'News', d: 'New releases and updates.' }] };
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const catalog = tools.filter((t) => fs.existsSync(`./public/img/tools/${t.slug}-review.jpg`)).slice(0, 8);
const tag = (s: string) => ({ best: ru ? 'Лучшее' : 'Best of', gear: ru ? 'Оборудование' : 'Gear', news: ru ? 'Новости' : 'News', guides: ru ? 'Гайд' : 'Guide', compare: ru ? 'Сравнение' : 'Compare', 'business-tools': ru ? 'Бизнес' : 'Business', reviews: ru ? 'Обзор' : 'Review' } as any)[s] ?? s;
---
<section class="hero-home">
  <h1>{T[lang as 'en' | 'ru'].tagline}</h1>
  <p class="lede">{L.lede}</p>
  <form class="hs" action={`${P}/search/`}><input type="search" name="q" placeholder={ru ? 'Поиск программ и статей' : 'Search tools and articles'} /></form>
  <p class="cta"><a class="btn" href={`${P}/software/`}>{L.browse}</a> <a class="btn ghost" href={`${P}/compare-tools/`}>{L.compare}</a></p>
</section>

{featured && (
  <section class="feat">
    <a class="big" href={href(featured)}>
      {featured.data.image ? <img src={featured.data.image} alt="" /> : <span class="ph">DT</span>}
      <div><span class="tag">{tag(featured.data.section)}</span><h2>{featured.data.title}</h2><p>{featured.data.description}</p><small>{fmt(featured.data.published ?? featured.data.updated)}</small></div>
    </a>
    <div class="side">
      {rest.slice(0, 4).map((a) => (
        <a class="mini" href={href(a)}>
          {a.data.image ? <img src={a.data.image} alt="" loading="lazy" /> : <span class="ph">DT</span>}
          <div><span class="tag">{tag(a.data.section)}</span><h3>{a.data.title}</h3><small>{fmt(a.data.published ?? a.data.updated)}</small></div>
        </a>
      ))}
    </div>
  </section>
)}

<h2 class="sec">{L.news} <a href={`${P}/news/`}>{L.all} →</a></h2>
<ul class="news">
  {news.map((a) => (<li><time>{fmt(a.data.published ?? a.data.updated)}</time> <a href={`/news/${a.id}/`}>{a.data.title}</a></li>))}
</ul>

<DesentaBox lang={lang} />

<h2 class="sec">{L.catalog} <a href={`${P}/software/`}>{L.all} →</a></h2>
<div class="strip">
  {catalog.map((t) => (
    <a class="tool" href={`${P}/reviews/${t.slug}-review/`}>
      <img src={`/img/tools/${t.slug}-review.jpg`} alt={t.name} loading="lazy" />
      <b>{t.name}</b><span>{t.price}</span>
    </a>
  ))}
</div>

<div class="grid tiles">
  {L.sections.map((s) => (<a class="card" href={`${P}${s.href}`}><h3>{s.t}</h3><p>{s.d}</p></a>))}
</div>

<style>
  .hero-home{padding:8px 0 20px}
  .hs input{width:100%;max-width:520px;font:inherit;padding:11px 16px;border-radius:12px;border:1px solid var(--line);background:var(--card);color:var(--fg);margin:4px 0 14px}
  .cta{display:flex;gap:10px;flex-wrap:wrap}
  .btn{background:linear-gradient(90deg,var(--accent),var(--accent2));color:#fff;text-decoration:none;font-weight:600;padding:9px 18px;border-radius:10px}
  .btn.ghost{background:none;border:1px solid var(--line);color:var(--fg)}
  .feat{display:grid;grid-template-columns:1.4fr 1fr;gap:18px;margin:12px 0 8px}
  @media (max-width:760px){.feat{grid-template-columns:1fr}}
  .big,.mini{display:block;background:var(--card);border:1px solid var(--line);border-radius:14px;overflow:hidden;color:var(--fg);text-decoration:none}
  .big:hover,.mini:hover{border-color:var(--accent)}
  .big img,.big .ph{width:100%;height:300px;object-fit:contain;display:block;background:#fff}
  .big .ph{object-fit:unset}
  .big div{padding:14px 18px 18px}
  .big h2{margin:6px 0;font-size:1.4rem;line-height:1.25}
  .big p{margin:0 0 6px;color:var(--muted);font-size:.95rem}
  .side{display:grid;gap:12px;align-content:start}
  .mini{display:flex;gap:12px;align-items:center}
  .mini img,.mini .ph{width:110px;height:78px;object-fit:contain;flex:none;background:#fff}
  .mini div{padding:8px 10px 8px 0}
  .mini h3{margin:2px 0;font-size:.95rem;line-height:1.3}
  .mini .ph,.big .ph{background:linear-gradient(135deg,var(--accent),var(--accent2))}
  .ph{display:flex;align-items:center;justify-content:center;font:700 1.6rem 'Space Grotesk',sans-serif;color:#fff;background:linear-gradient(135deg,var(--accent),var(--accent2))}
  .tag{font-size:.7rem;text-transform:uppercase;letter-spacing:.06em;color:var(--accent2);font-weight:700}
  small{color:var(--muted)}
  .sec{display:flex;justify-content:space-between;align-items:baseline;margin-top:2rem}
  .sec a{font-size:.9rem;font-weight:400}
  .news{list-style:none;padding:0;margin:0}
  .news li{padding:9px 0;border-bottom:1px solid var(--line)}
  .news time{color:var(--muted);font-size:.85rem;margin-right:10px}
  .strip{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:12px}
  .tool{display:flex;flex-direction:column;gap:2px;background:var(--card);border:1px solid var(--line);border-radius:12px;overflow:hidden;text-decoration:none;color:var(--fg);padding-bottom:10px}
  .tool:hover{border-color:var(--accent)}
  .tool img{width:100%;aspect-ratio:16/9;object-fit:contain;background:#fff;margin-bottom:6px}
  .tool b,.tool span{padding:0 12px}
  .tool b{font-size:.95rem}
  .tool span{font-size:.8rem;color:var(--muted)}
  .tiles{margin-top:2rem}
</style>
