---
import { getCollection } from 'astro:content';
import { T, type Lang } from '../i18n';
interface Props { section: 'best' | 'compare' | 'reviews' | 'business-tools' | 'guides' | 'gear' | 'news'; lang?: Lang; }
const { section, lang = 'en' } = Astro.props;
const prefix = lang === 'ru' ? '/ru' : '';
const items = (await getCollection('articles', (a) => a.data.section === section && a.data.lang === lang && !a.data.draft))
  .sort((a, b) => (b.data.published ?? b.data.updated).valueOf() - (a.data.published ?? a.data.updated).valueOf());
---
{items.length === 0 ? (
  <p class="notice">{T[lang].soon}</p>
) : (
  <div class="blocks">
    {items.map((a) => (
      <a class="block" href={`${prefix}/${section}/${a.id.replace(/^ru\//, '')}/`}>
        {a.data.image ? <img src={a.data.image} alt="" loading="lazy" /> : <span class="ph">DT</span>}
        <div class="body">
          <h3>{a.data.title}</h3>
          <p>{a.data.description}</p>
          <small>{(a.data.published ?? a.data.updated).toISOString().slice(0, 10)}</small>
        </div>
      </a>
    ))}
  </div>
)}
<style>
  .blocks{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px;margin:20px 0}
  .block{display:flex;flex-direction:column;background:var(--card);border:1px solid var(--line);border-radius:14px;overflow:hidden;color:var(--fg);text-decoration:none}
  .block:hover{border-color:var(--accent)}
  .block img,.block .ph{width:100%;aspect-ratio:16/9;object-fit:contain;background:#fff;display:block}
  .block .ph{object-fit:unset;display:flex;align-items:center;justify-content:center;font:700 2rem 'Space Grotesk',sans-serif;color:#fff;background:linear-gradient(135deg,var(--accent),var(--accent2))}
  .block .body{padding:12px 16px 16px;display:flex;flex-direction:column;gap:6px;flex:1}
  .block h3{margin:0;font-size:1.05rem;line-height:1.3}
  .block p{margin:0;color:var(--muted);font-size:.9rem;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  .block small{margin-top:auto;color:var(--muted)}
</style>
