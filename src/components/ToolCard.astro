---
import fs from 'node:fs';
import { UI } from '../data/ui';
const { t, lang = 'en', cmp } = Astro.props;
const L = UI[lang as 'en' | 'ru'];
const img = fs.existsSync(`./public/img/tools/${t.slug}-review.jpg`) ? `/img/tools/${t.slug}-review.jpg` : '';
---
<div class="tc">
  <a class="th" href={`${L.prefix}/reviews/${t.slug}-review/`}>{img ? <img src={img} alt="" loading="lazy" /> : <span>DT</span>}</a>
  <h3>{t.name}</h3>
  <p class="chips"><span>{L.cats[t.cat as keyof typeof L.cats]}</span><span class={t.free !== 'no' ? 'g' : ''}>{L.free[t.free as 'yes']}</span></p>
  <p class="pr">{t.price}</p>
  <p class="nt">{t.note}</p>
  <p><a href={`${L.prefix}/reviews/${t.slug}-review/`}>{L.review}</a>{cmp && <> · <a href={`${L.prefix}/compare-tools/#${cmp}`}>{L.compare}</a></>}</p>
</div>
<style>
  .tc{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px 16px;overflow:hidden}
  .th{display:block;margin:-14px -16px 12px;aspect-ratio:16/9;background:#fff;border-radius:12px 12px 0 0}
  .th img{width:100%;height:100%;object-fit:contain;display:block}.th span{display:flex;height:100%;align-items:center;justify-content:center;font:700 2rem 'Space Grotesk',sans-serif;color:#fff;background:linear-gradient(135deg,#2F4FE8,#0FB88C)}
  .tc h3{margin:0 0 6px}.chips{display:flex;gap:6px;flex-wrap:wrap;margin:0 0 8px}.chips span{font-size:.78rem;border:1px solid var(--line);border-radius:999px;padding:1px 9px;color:var(--muted)}.chips .g{color:#0a8f6c;border-color:#0a8f6c}
  .pr{font-weight:600;margin:.3em 0}.nt{color:var(--muted);font-size:.92rem;margin:.3em 0 .6em}
</style>
