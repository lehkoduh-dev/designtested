---
import { SITE } from '../site';
import { T, altPath, type Lang } from '../i18n';
interface Props { title: string; description: string; lang?: Lang; alt?: string | null; }
const { title, description, lang = 'en', alt } = Astro.props;
const t = T[lang];
const prefix = lang === 'ru' ? '/ru' : '';
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const fullTitle = title === SITE.name ? `${SITE.name} — ${t.tagline}` : `${title} | ${SITE.name}`;
const altHref = alt === undefined ? altPath(Astro.url.pathname, lang) : alt;
const altLang = lang === 'en' ? 'ru' : 'en';
const nav = t.nav.map((n) => ({ href: prefix + n.path, label: n.label }));
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {altHref && <link rel="alternate" hreflang={lang} href={canonical} />}
    {altHref && <link rel="alternate" hreflang={altLang} href={new URL(altHref, SITE.url).href} />}
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0A0F1F" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': [
      { '@type': 'Organization', '@id': 'https://designtested.com/#org', name: 'DesignTested', url: 'https://designtested.com/', logo: 'https://designtested.com/brand/logo-mark.svg' },
      { '@type': 'WebSite', '@id': 'https://designtested.com/#site', url: 'https://designtested.com/', name: 'DesignTested', publisher: { '@id': 'https://designtested.com/#org' }, inLanguage: lang, potentialAction: { '@type': 'SearchAction', target: 'https://designtested.com/search/?q={search_term_string}', 'query-input': 'required name=search_term_string' } },
    ] })} />
    <slot name="head" />

    <meta property="og:image" content="https://designtested.com/brand/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/space-grotesk-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={prefix + '/'}><img src="/brand/logo-mark.svg" alt="" width="30" height="30" /><b class="wm">Design<span>Tested</span></b></a>
        <nav>
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          {altHref && <a class="lang" href={altHref} hreflang={altLang} lang={altLang}>{t.switchTo}</a>}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p><strong>{SITE.name}</strong> — {t.tagline}</p>
        <p class="small">
          {prefix === '/ru' ? 'DesignTested делает команда, стоящая за ' : 'DesignTested is made by the team behind '}<a href="https://desenta.com" target="_blank" rel="noopener">Desenta</a>. {t.footerDisclosure} <a href={prefix + '/affiliate-disclosure/'}>{t.disclosureLink}</a>.
        </p>
        <p class="small">
          {t.footerLinks.map((l, i) => (<Fragment>{i > 0 && ' · '}<a href={prefix + l.path}>{l.label}</a></Fragment>))}
        </p>
      </div>
    </footer>
    <style is:global>
      :root {
        --bg: #f6f8fc; --fg: #0a0f1f; --muted: #5a6478; --line: #e1e6f0;
        --accent: #2f4fe8; --accent2: #0fb88c; --card: #ffffff;
      }
      @media (prefers-color-scheme: dark) {
        :root { --bg: #0a0f1f; --fg: #eaf0ff; --muted: #9aa6bf; --line: #1f2840; --accent: #7f98ff; --accent2: #19e3b1; --card: #111833; }
      }
      @font-face { font-family: 'Space Grotesk'; font-weight: 500; font-display: swap; src: url('/fonts/space-grotesk-latin-500-normal.woff2') format('woff2'); }
      @font-face { font-family: 'Space Grotesk'; font-weight: 700; font-display: swap; src: url('/fonts/space-grotesk-latin-700-normal.woff2') format('woff2'); }
      h1, h2, h3, .brand { font-family: 'Space Grotesk', system-ui, sans-serif; letter-spacing: -0.02em; }
      h1 { line-height: 1.15; }
      .site-header { background: linear-gradient(90deg, rgba(47,79,232,.07), rgba(15,184,140,.07)); }
      .brand { display: inline-flex; align-items: center; gap: 9px; }
      .brand img { display: block; border-radius: 8px; }
      .wm { font-weight: 700; } .brand span { background: linear-gradient(90deg, var(--accent), var(--accent2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--fg); font: 17px/1.65 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }
      .wrap { max-width: 1200px; margin: 0 auto; padding: 0 16px; }
      a { color: var(--accent); }
      .site-header { border-bottom: 1px solid var(--line); }
      .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 24px; padding-top: 14px; padding-bottom: 14px; }
      .brand { font-weight: 800; font-size: 1.25rem; text-decoration: none; color: var(--fg); letter-spacing: -0.02em; }
      .brand span { color: var(--accent); }
      nav { display: flex; flex-wrap: wrap; gap: 4px 18px; }
      nav a { color: var(--muted); text-decoration: none; font-size: 0.95rem; }
      nav a:hover { color: var(--fg); }
      nav a.lang { border: 1px solid var(--line); border-radius: 6px; padding: 0 8px; color: var(--fg); }
      .wrap > :is(p,h1,h2,h3,ul,ol,blockquote,form,table,section.ratings){max-width:820px}
      article{max-width:820px;margin:0 auto}
      img.tb{display:block;width:100%;max-width:420px;height:auto;aspect-ratio:16/9;border-radius:14px;margin:0 0 16px}
      main { padding-top: 32px; padding-bottom: 48px; }
      h1 { font-size: clamp(1.9rem, 5vw, 2.6rem); line-height: 1.15; letter-spacing: -0.02em; margin: 0 0 12px; }
      h2 { margin-top: 2em; letter-spacing: -0.01em; }
      .lede { color: var(--muted); font-size: 1.15rem; margin-bottom: 28px; }
      .grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); margin: 24px 0; }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 18px; text-decoration: none; color: var(--fg); display: block; }
      .card:hover { border-color: var(--accent); }
      .card h3 { margin: 0 0 6px; font-size: 1.05rem; }
      .card p { margin: 0; color: var(--muted); font-size: 0.95rem; }
      .list { list-style: none; padding: 0; margin: 20px 0; }
      .list li { padding: 14px 0; border-bottom: 1px solid var(--line); }
      .list a { font-weight: 600; text-decoration: none; }
      .list p { margin: 4px 0 0; color: var(--muted); font-size: 0.95rem; }
      .notice { background: var(--card); border: 1px solid var(--line); border-left: 4px solid var(--accent); border-radius: 8px; padding: 12px 16px; font-size: 0.92rem; color: var(--muted); margin: 20px 0; }
      .site-footer { border-top: 1px solid var(--line); padding: 28px 0 40px; color: var(--muted); }
      .small { font-size: 0.85rem; }
      table { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: 0.95rem; }
      th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
      th { color: var(--muted); font-weight: 600; }
      .meta { color: var(--muted); font-size: 0.9rem; margin-bottom: 20px; }
      @media (max-width: 600px) { table { display: block; overflow-x: auto; } }
      article img{max-width:100%;height:auto;max-height:420px;object-fit:contain;display:block;margin:1rem 0;border-radius:8px;background:#fff}  .pick{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:6px 20px 14px;margin:18px 0}.pick.top{border-color:var(--accent2);box-shadow:0 0 0 1px var(--accent2) inset}.pick h2{margin-top:.8em}.pick img{max-height:300px;margin:.6rem 0}.pick small{color:var(--muted)}  .quick{background:var(--card);border:1px solid var(--line);border-left:4px solid var(--accent2);border-radius:12px;padding:4px 18px 10px;margin:18px 0}.quick h2{margin:.6em 0 .3em;font-size:1.1rem}.quick p{margin:.35em 0}figure.hero{margin:1.2rem 0}figure.hero img{width:100%;height:auto;max-height:420px;object-fit:contain;background:#fff;border-radius:8px;display:block}figure.hero figcaption{font-size:.8rem;color:var(--muted,#666);margin-top:.4rem}
    </style>
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "5143b7b0d1c2424fb672104d72b770b4"}'></script>
  </body>
</html>
