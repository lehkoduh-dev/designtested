---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { T } from '../../i18n';

export async function getStaticPaths() {
  const items = await getCollection('articles', (a) => a.data.lang === 'en' && !a.data.draft);
  return items.map((entry) => ({
    params: { section: entry.data.section, slug: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const date = entry.data.updated.toISOString().slice(0, 10);
const t = T.en;
---
<Base title={entry.data.title} description={entry.data.description} alt={null}>
  <article>
    <h1>{entry.data.title}</h1>
    <p class="meta">{t.lastUpdated} {date} · {t.byTeam}</p>
    <p class="notice">{t.articleDisclosure} <a href="/affiliate-disclosure/">{t.details}</a>.</p>
    <Content />
  </article>
</Base>
