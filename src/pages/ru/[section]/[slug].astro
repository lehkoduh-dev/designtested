---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { T } from '../../../i18n';

export async function getStaticPaths() {
  const items = await getCollection('articles', (a) => a.data.lang === 'ru' && !a.data.draft);
  return items.map((entry) => ({
    params: { section: entry.data.section, slug: entry.id.replace(/^ru\//, '') },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const date = entry.data.updated.toISOString().slice(0, 10);
const t = T.ru;
---
<Base lang="ru" title={entry.data.title} description={entry.data.description} alt={null}>
  <article>
    <h1>{entry.data.title}</h1>
    <p class="meta">{t.lastUpdated} {date} · {t.byTeam}</p>
    {entry.data.affiliate && <p class="notice">{t.articleDisclosure} <a href="/ru/affiliate-disclosure/">{t.details}</a>.</p>}
    {entry.data.image && (
      <figure class="hero">
        <img src={entry.data.image} alt={entry.data.vendor ?? entry.data.title} loading="lazy" width="1024" />
        <figcaption>Image: {entry.data.imageCredit ?? 'official website'}{entry.data.officialUrl && <> · <a href={entry.data.officialUrl} rel="nofollow noopener" target="_blank">Official site</a></>}</figcaption>
      </figure>
    )}
    <Content />
  </article>
</Base>
