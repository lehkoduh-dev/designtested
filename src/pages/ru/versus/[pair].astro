---
import Base from '../../../layouts/Base.astro';
import Versus from '../../../components/Versus.astro';
import { tools } from '../../../data/tools';
import { pairs } from '../../../data/ui';
export function getStaticPaths() { return pairs.map(([a, b]) => ({ params: { pair: `${a}-vs-${b}` }, props: { a, b } })); }
const { a, b } = Astro.props;
const n = (s: string) => tools.find((t) => t.slug === s)!.name;
---
<Base title={`${n(a)} или ${n(b)}: сравнение цены и возможностей`} description={`${n(a)} и ${n(b)}: тип, бесплатные тарифы, цена и особенности рядом, по данным официальных сайтов.`} lang="ru" alt={`/versus/${a}-vs-${b}/`}>
  <h1>{n(a)} или {n(b)}</h1>
  <Versus a={a} b={b} lang="ru" />
</Base>
